# ==============================================================================
# POSTGRESQL DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL Superuser / Database Owner
POSTGRES_USER=postgres

# PostgreSQL Superuser Password
POSTGRES_PASSWORD=postgres

# Initial Database Name to create on startup
POSTGRES_DB=steam

# Application Database Connection Parameters
DB_NAME=steam
DB_HOST=postgres
DB_PORT=5432

# Complete PostgreSQL connection URI (Format: postgresql://USER:PASSWORD@HOST:PORT/DB)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/steam

# ==============================================================================
# EXTERNAL INTEGRATIONS & API KEYS
# ==============================================================================
# Web API Key for Steam services (Get yours at: https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your_steam_api_key_here

# API Key for internal/external Scala service authorization
SCALA_API_KEY=your_scala_api_key_here

# Default admin username for internal CRUD service operations
CRUD_USERNAME=admin