# ===================================
# POSTGRESQL DATABASE CONFIGURATION
# ===================================
# Master credentials for the PostgreSQL instance/container
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=steam

# Database network configuration
DB_HOST=postgres
DB_PORT=8000

# Complete connection string used by Doobie JDBC drivers:
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<DB_HOST>:<DB_PORT>/<POSTGRES_DB>
DATABASE_URL=postgresql://user:password@postgres:8000/steam


# ===================================
# API KEYS & SECURITY CREDENTIALS
# ===================================

# 1. REQUIRED: Personal Steam Web API key.
# Required to fetch external data (Users, Games, Achievements) from the official Steam Web API.
# Obtain your key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# 2. REQUIRED: Internal security key for protecting this Scala (http4s) REST API.
# Must be passed in the "X-API-Key" HTTP header to authenticate all incoming client requests.
SCALA_API_KEY=your_secret_server_key_123